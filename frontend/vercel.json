{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ai-game-balancer.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://ai-game-balancer.onrender.com/health" },
    { "source": "/analyze", "destination": "https://ai-game-balancer.onrender.com/analyze" },
    { "source": "/((?!api/|health$|analyze$).*)", "destination": "/index.html" }
  ]
}
